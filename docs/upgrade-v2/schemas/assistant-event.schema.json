{
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "message.delta",
        "tool.started",
        "tool.completed",
        "tool.failed",
        "draft.changed",
        "scan.progress",
        "test.progress",
        "task.completed",
        "task.cancelled",
        "task.failed",
        "task.interrupted",
        "usage.updated"
      ]
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "workflowId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "eventId",
    "type",
    "timestamp",
    "data"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
