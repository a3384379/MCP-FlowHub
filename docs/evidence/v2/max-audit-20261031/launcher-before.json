          "lineStart": 81,
          "lineEnd": 90
        }
      ],
      "trigger": "保持默认右侧入口；使用Chromium CDP Emulation.setPageScaleFactor(pageScaleFactor:2)产生实际visualViewport缩放。基准布局1440x900或390x844。",
      "observed": {
        "1440x900_at_2x": {
          "visualWidth": 720,
          "visualHeight": 450,
          "panelLeft": 996,
          "panelRight": 1416,
          "panelTop": 156,
          "panelBottom": 808,
          "launcherLeft": 654,
          "launcherRight": 708
        },
        "390x844_at_2x": {
          "visualWidth": 195,
          "visualHeight": 422,
          "panelWidth": 390,
          "panelBottom": 422,
          "sendLeft": 333,
          "closeLeft": 339
        }
      },
      "cause": "入口使用visualViewport宽、高、offsetLeft、offsetTop，而FloatingAssistant只设置height/top变量；桌面窗仍按layout viewport的right:24px/bottom:92px/dvh定位，手机仍width:100%且left:0。缩放后两者坐标空间脱节。",
      "impact": "默认右侧桌面入口可见但整个聊天窗在屏幕右方；手机聊天窗只有左半边可见，发送和收起按钮在可视区外。必须先平移或缩小页面才能恢复正常操作。",
      "minimumFix": "共享同一visualViewport矩形，将width、height、offsetLeft、offsetTop应用到面板的最大宽高、左右锚点和上下限位；根据实际可视宽度收紧布局，不只依赖layout viewport媒体查询。保留用户放大能力。",
      "regression": "使用真实CDP pageScaleFactor2/3（不是改window属性）覆盖默认左右两边、收起/展开、宽窗/窄窗，后续补实际touch pan产生非零offsetLeft/Top；断言入口和面板controls处于当前visualViewport内，移动入口不丢失文本或session、不创建模型任务。",
      "evidence": [
        "geometry.json",
        "final-geometry.log",
        "probe-final.js",
        "final-pinch-1440x900.png",
        "final-pinch-390x844.png"
      ]
    }
