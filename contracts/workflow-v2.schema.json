{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flowhub/schemas/workflow/v2",
  "title": "FlowHub workflow v2",
  "description": "FlowHub constrained workflow schema. Graph semantics, references, schema hashes and environment bindings require domain validation.",
  "$comment": "The examples are MOCK ONLY. Unknown DSL/config keys are forbidden. Dictionary keys and literal JSON values are data. No remote schema retrieval is allowed.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "flowhub.workflow/v2"
    },
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "environment": {
      "enum": [
        "production",
        "staging",
        "test"
      ]
    },
    "mode": {
      "enum": [
        "guided",
        "auto"
      ]
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      }
    },
    "inputSchema": {
      "$ref": "#/$defs/dataSchema"
    },
    "bindings": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,63}$"
      },
      "description": "Role-to-bindingRef dictionary. Example roles are log and db; every role referenced by a node must exist here."
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "minItems": 0,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "budgets": {
      "$ref": "#/$defs/budgets"
    },
    "executionRequirements": {
      "type": "object",
      "properties": {
        "requiresCodex": {
          "type": "boolean"
        },
        "executors": {
          "type": "array",
          "items": {
            "enum": [
              "hub_direct",
              "codex_host",
              "assistant_local"
            ]
          }
        },
        "capabilityRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "capabilityId": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "capabilityId",
              "revision"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "workflowId",
    "name",
    "description",
    "version",
    "environment",
    "mode",
    "tags",
    "inputSchema",
    "bindings",
    "nodes",
    "edges",
    "budgets"
  ],
  "additionalProperties": false,
  "$defs": {
    "jsonValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ],
      "description": "Arbitrary JSON literal data, not executable configuration."
    },
    "dataSchema": {
      "type": "object",
      "properties": {
        "$schema": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        },
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "boolean",
            "integer",
            "number",
            "null"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "properties": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/dataSchema"
          }
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "uniqueItems": true,
          "maxItems": 128
        },
        "additionalProperties": {
          "const": false
        },
        "items": {
          "$ref": "#/$defs/dataSchema"
        },
        "enum": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          },
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "const": {
          "$ref": "#/$defs/jsonValue"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          },
          "maxItems": 8
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "pattern": {
          "type": "string",
          "maxLength": 512
        },
        "format": {
          "enum": [
            "date-time",
            "date",
            "uri",
            "uuid"
          ]
        },
        "minItems": {
          "type": "integer",
          "minimum": 0
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "uniqueItems": {
          "type": "boolean"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "description": "Deliberately restricted JSON Schema subset for workflow input and agent output. External $ref, code, and arbitrary keywords are not accepted. Values under properties are schemas; values under const/examples are inert data.",
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "object"
              }
            }
          },
          "then": {
            "required": [
              "properties",
              "additionalProperties"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "array"
              }
            }
          },
          "then": {
            "required": [
              "items"
            ]
          }
        }
      ]
    },
    "mapping": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/jsonValue"
            }
          },
          "required": [
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ref": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "source": {
                      "const": "input"
                    },
                    "pointer": {
                      "type": "string",
                      "maxLength": 512,
                      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                    }
                  },
                  "required": [
                    "source",
                    "pointer"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "source": {
                      "const": "node"
                    },
                    "nodeId": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                    },
                    "pointer": {
                      "type": "string",
                      "maxLength": 512,
                      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                    }
                  },
                  "required": [
                    "source",
                    "nodeId",
                    "pointer"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "ref"
          ],
          "additionalProperties": false
        }
      ]
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "eq"
            },
            "left": {
              "$ref": "#/$defs/mapping"
            },
            "right": {
              "$ref": "#/$defs/mapping"
            }
          },
          "required": [
            "op",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "exists"
            },
            "value": {
              "$ref": "#/$defs/mapping"
            }
          },
          "required": [
            "op",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "and",
                "or"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 2,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Typed, side-effect-free finite AST. The runtime caps depth and operation count; there is no eval, JavaScript, SQL, network access, or interpolation."
    },
    "inputConfig": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "mcpToolConfig": {
      "type": "object",
      "properties": {
        "bindingKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "toolName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "toolSchemaHash": {
          "type": "string",
          "pattern": "^(?:sha256:[0-9a-f]{64}|placeholder:[a-z0-9._-]{1,128})$",
          "description": "placeholder is intentionally permitted for design fixtures only. Domain validation MUST forbid real execution/publication when a placeholder remains."
        },
        "argumentsMappings": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/mapping"
          },
          "description": "Keys are destination JSON Pointers. Overlapping destinations and locked binding fields are rejected by domain validation. No expressions are evaluated."
        },
        "outputSchemaRef": {
          "type": "string",
          "pattern": "^flowhub://schemas/[a-z0-9/._-]+$",
          "maxLength": 256,
          "description": "Built-in schema registry reference only; never fetch this URI over the network."
        },
        "capabilityRef": {
          "type": "object",
          "properties": {
            "capabilityId": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "capabilityId",
            "revision"
          ],
          "additionalProperties": false
        },
        "rowLimitArgument": {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)+$",
          "maxLength": 512,
          "description": "Explicit native numeric row-limit argument pointer. No limit parameter name is guessed. Without this, pre-dispatch enforcement is recorded as unsupported."
        },
        "resultAdapterRef": {
          "enum": [
            "structured",
            "text",
            "json_text"
          ]
        },
        "businessVerification": {
          "$ref": "#/$defs/businessVerification"
        }
      },
      "required": [
        "bindingKey",
        "toolName",
        "toolSchemaHash",
        "argumentsMappings"
      ],
      "additionalProperties": false
    },
    "hostPluginConfig": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "host_plugin"
        },
        "executorRef": {
          "const": "codex_host"
        },
        "pluginRef": {
          "type": "object",
          "properties": {
            "pluginId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "pluginId",
            "revision"
          ],
          "additionalProperties": false
        },
        "profile": {
          "enum": [
            "read_only",
            "flowtest_lite"
          ]
        },
        "scope": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "environmentId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          },
          "required": [
            "projectId",
            "environmentId"
          ],
          "additionalProperties": false
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "inputMappings": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/mapping"
          },
          "description": "Keys are destination JSON Pointers. Overlapping destinations and locked binding fields are rejected by domain validation. No expressions are evaluated."
        },
        "outputSchema": {
          "$ref": "#/$defs/dataSchema"
        },
        "businessVerification": {
          "$ref": "#/$defs/businessVerification"
        }
      },
      "required": [
        "kind",
        "executorRef",
        "pluginRef",
        "profile",
        "instructions",
        "inputMappings",
        "outputSchema"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "profile": {
            "const": "flowtest_lite"
          }
        }
      },
      "then": {
        "required": [
          "scope"
        ]
      },
      "else": {
        "not": {
          "required": [
            "scope"
          ]
        }
      }
    },
    "analysisConfig": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "analysis"
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "inputMappings": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/mapping"
          },
          "description": "Keys are destination JSON Pointers. Overlapping destinations and locked binding fields are rejected by domain validation. No expressions are evaluated."
        },
        "outputSchema": {
          "$ref": "#/$defs/dataSchema"
        },
        "capabilityRef": {
          "type": "object",
          "properties": {
            "capabilityId": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "capabilityId",
            "revision"
          ],
          "additionalProperties": false
        },
        "executorRef": {
          "enum": [
            "codex_host",
            "assistant_local"
          ]
        },
        "businessVerification": {
          "$ref": "#/$defs/businessVerification"
        }
      },
      "required": [
        "kind",
        "instructions",
        "inputMappings",
        "outputSchema"
      ],
      "additionalProperties": false
    },
    "hostSkillConfig": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "host_skill"
        },
        "skillRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        },
        "inputMappings": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/mapping"
          },
          "description": "Keys are destination JSON Pointers. Overlapping destinations and locked binding fields are rejected by domain validation. No expressions are evaluated."
        },
        "outputSchema": {
          "$ref": "#/$defs/dataSchema"
        },
        "reportContractRef": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+/v[1-9][0-9]*$",
          "maxLength": 128
        },
        "fallbackTemplateRef": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+/v[1-9][0-9]*$",
          "maxLength": 128,
          "description": "A predeclared fallback, not implicit permission. The caller must explicitly request fallback and the engine must record it."
        },
        "capabilityRef": {
          "type": "object",
          "properties": {
            "capabilityId": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "capabilityId",
            "revision"
          ],
          "additionalProperties": false
        },
        "executorRef": {
          "enum": [
            "codex_host",
            "assistant_local"
          ]
        }
      },
      "required": [
        "kind",
        "skillRef",
        "instructions",
        "inputMappings",
        "outputSchema",
        "reportContractRef"
      ],
      "additionalProperties": false
    },
    "agentTaskConfig": {
      "oneOf": [
        {
          "$ref": "#/$defs/analysisConfig"
        },
        {
          "$ref": "#/$defs/hostSkillConfig"
        },
        {
          "$ref": "#/$defs/hostToolConfig"
        },
        {
          "$ref": "#/$defs/hostPluginConfig"
        }
      ]
    },
    "conditionConfig": {
      "type": "object",
      "properties": {
        "expression": {
          "$ref": "#/$defs/condition"
        }
      },
      "required": [
        "expression"
      ],
      "additionalProperties": false
    },
    "reportTemplateConfig": {
      "type": "object",
      "properties": {
        "templateRef": {
          "type": "string",
          "pattern": "^[a-z0-9._-]+/v[1-9][0-9]*$",
          "maxLength": 128
        },
        "inputMappings": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/mapping"
          },
          "description": "Keys are destination JSON Pointers. Overlapping destinations and locked binding fields are rejected by domain validation. No expressions are evaluated."
        },
        "outputSchema": {
          "$ref": "#/$defs/dataSchema"
        }
      },
      "required": [
        "templateRef",
        "inputMappings",
        "outputSchema"
      ],
      "additionalProperties": false
    },
    "endConfig": {
      "type": "object",
      "properties": {
        "resultRef": {
          "$ref": "#/$defs/mapping"
        }
      },
      "required": [
        "resultRef"
      ],
      "additionalProperties": false
    },
    "node": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "type": {
              "const": "input"
            },
            "config": {
              "$ref": "#/$defs/inputConfig"
            }
          },
          "required": [
            "id",
            "title",
            "type",
            "config"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "type": {
              "const": "mcp_tool"
            },
            "config": {
              "$ref": "#/$defs/mcpToolConfig"
            }
          },
          "required": [
            "id",
            "title",
            "type",
            "config"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "type": {
              "const": "agent_task"
            },
            "config": {
              "$ref": "#/$defs/agentTaskConfig"
            }
          },
          "required": [
            "id",
            "title",
            "type",
            "config"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "type": {
              "const": "condition"
            },
            "config": {
              "$ref": "#/$defs/conditionConfig"
            }
          },
          "required": [
            "id",
            "title",
            "type",
            "config"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "type": {
              "const": "report_template"
            },
            "config": {
              "$ref": "#/$defs/reportTemplateConfig"
            }
          },
          "required": [
            "id",
            "title",
            "type",
            "config"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "type": {
