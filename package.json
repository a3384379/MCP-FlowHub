{
  "name": "mcp-flowhub",
  "version": "2.0.0-alpha.8",
  "private": true,
  "type": "module",
  "description": "Local MCP workflow hub with visual MCP orchestration, immutable workflows and evidence reports",
  "engines": {
    "node": "24.19.0",
    "npm": "11.9.0"
  },
  "packageManager": "npm@11.9.0",
  "bin": {
    "flowhub": "dist/apps/daemon/src/cli.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json && node scripts/verify_design.mjs",
    "test": "npm run build && node --test --test-concurrency=1 --test-timeout=60000 dist/tests/poc/*.test.js dist/tests/engine/*.test.js",
    "test:protocol": "npm run build && node --test --test-timeout=30000 dist/tests/poc/protocol.test.js",
    "start": "node dist/apps/daemon/src/cli.js serve",
    "mcp": "node dist/apps/daemon/src/cli.js mcp --stdio",
    "package:local": "npm run build && node scripts/package.mjs",
    "package:plugin": "npm run package:local",
    "package:windows": "npm run build && node scripts/package.mjs --windows",
    "installer:windows": "node scripts/windows-installer.mjs",
    "test:installer:windows": "node scripts/smoke-windows-installer.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "test:plugin": "node scripts/smoke-plugin.mjs",
    "test:plugin:e2e": "npm run build:server && node scripts/accept-installed-plugin.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "build:server": "node scripts/generate-openapi.mjs && tsc -p tsconfig.json",
    "build:web": "tsc -p apps/web/tsconfig.json && vite build && vite build --config apps/web/vite.sidebar.config.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "test:ui": "playwright test",
    "test:authoring": "npm run build:server && node --test dist/tests/engine/v2-authoring.test.js",
    "test:discovery": "npm run build:server && node --test dist/tests/engine/v2-discovery.test.js",
    "test:selftest": "npm run build:server && node --test dist/tests/engine/v2-mcp-selftest.test.js",
    "test:assistant": "npm run build:server && node --test dist/tests/engine/v2-assistant.test.js",
    "test:codex-local": "npm run build:server && node scripts/smoke-codex-v2.mjs",
    "test:upgrade-local": "npm run build:server && node scripts/smoke-v2-upgrade.mjs",
    "benchmark:v2": "npm run build:server && node scripts/benchmark-v2.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@xyflow/react": "12.12.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.7",
    "markdown-it": "15.0.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
